                    "value": "dead_active"
                  }
                ]
              },
              "max_dist": 36
            }
          ]
        },
        "minecraft:behavior.melee_attack": {
          "priority": 3,
          "speed_multiplier": 1,
          "track_target": true
        }
      }
    },
    "components": {
